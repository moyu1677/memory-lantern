{
  "version": "2.0-final-frozen",
  "purpose": "24 个在模型调用前冻结的受控多轮案例。它检验的是系统是否能把已给定的聊天线索安全地归类、克制地放弃和给出对应行动类别；不把它表述为真实老人需求准确率或医疗结论。",
  "action_type_definitions": {
    "contact_companionship": "主动联系、倾听或陪伴",
    "shared_activity": "一起参与一件具体活动",
    "daily_step_support": "协助完成具体日常事项",
    "safety_check": "先确认安全并陪同处理"
  },
  "cases": [
    {
      "id": "core_psych_contact",
      "group": "clear_psychological",
      "expected_status": "signals_present",
      "expected_areas": ["psychological"],
      "expected_action_types": ["contact_companionship"],
      "history": [
        {"role": "user", "content": "这两天晚饭后屋里特别安静。"},
        {"role": "assistant", "content": "您通常会做些什么呢？"},
        {"role": "user", "content": "我不想总打扰孩子，可要是他们周末能跟我通一会儿电话，我会踏实些。"}
      ]
    },
    {
