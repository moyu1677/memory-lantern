# 仅部署在 GPU 服务器。设置为一个足够长的随机值，并同步填写到应用服务器的 INDEXTTS2_API_KEY。
VOICE_API_KEY=
# 默认仅监听本机；通过 SSH 隧道或受控内网访问，不直接暴露到公网。
VOICE_SERVER_HOST=127.0.0.1
VOICE_SERVER_PORT=5000
VOICE_PROFILE_DIR=./voice_profiles
INDEXTTS2_MODEL_DIR=checkpoints
INDEXTTS2_CONFIG_PATH=checkpoints/config.yaml
INDEXTTS2_USE_FP16=true
INDEXTTS2_USE_CUDA_KERNEL=false
INDEXTTS2_USE_DEEPSPEED=false
# 在线语音推理独占物理 1 号卡；训练请使用物理 0 号卡。
CUDA_VISIBLE_DEVICES=1
