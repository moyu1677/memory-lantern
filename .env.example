DEEPSEEK_API_KEY=请填写你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
FLASK_SECRET_KEY=请填写一段随机且保密的字符串
DATABASE_PATH=
SESSION_COOKIE_SECURE=false
TENCENT_ASR_APP_ID=请填写腾讯云AppID
TENCENT_ASR_SECRET_ID=请填写腾讯云SecretID
TENCENT_ASR_SECRET_KEY=请填写腾讯云SecretKey
# 兼容旧配置：潮汕话未单独设置时会使用这一项
TENCENT_ASR_ENGINE=16k_zh_en
TENCENT_ASR_ENGINE_MANDARIN=16k_zh_en
TENCENT_ASR_ENGINE_CHAOSHAN=16k_zh_en
TENCENT_ASR_ENGINE_CANTONESE=16k_yue
# 绘图机器辅助评分：模型目录与最低自动预测置信度
DRAWING_MODEL_DIR=data/models
DRAWING_CONFIDENCE_THRESHOLD=0.75
# 可选：不填写时读取项目内实验目录的 best_model.pt
