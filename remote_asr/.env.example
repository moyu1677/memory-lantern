# Bind only to loopback and access from the local application through SSH tunneling.
ASR_API_KEY=
# This service loads a local Whisper large-v3 checkpoint; do not rely on a runtime download.
ASR_MODEL_PATH=/absolute/path/to/local/whisper-large-v3
ASR_DEVICE=cuda:0
ASR_CUDA_VISIBLE_DEVICES=1
ASR_SERVER_HOST=127.0.0.1
ASR_SERVER_PORT=8000
